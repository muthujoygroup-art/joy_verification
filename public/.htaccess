# Apache / cPanel Single Page Application (SPA) Routing for JOY Verification
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Prioritize React SPA index.html for root and directory requests
  DirectoryIndex index.html index.php
  
  # Allow direct access to existing files & folders (assets, api, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Route all other URLs (/login, /hr, /superadmin, /company, /verify) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
